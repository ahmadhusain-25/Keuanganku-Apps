# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FONNTE_API_KEY: Fonnte API Key for WhatsApp Bot
FONNTE_API_KEY=o2ibg27orvbi75tc4fDi

# OPENROUTER_API_KEY: OpenRouter API key for LLM fallbacks.
OPENROUTER_API_KEY=

# NVIDIA_API_KEY: NVIDIA API key for LLM fallbacks.
NVIDIA_API_KEY=

# QDRANT_URL: The REST URL of your Qdrant cluster (e.g. https://your-qdrant-id.gcp.qdrant.io)
QDRANT_URL=

# QDRANT_API_KEY: Qdrant cluster authorization API key (optional, has a built-in default)
QDRANT_API_KEY=

# CLOUDFLARE_API_KEY: Cloudflare API Token for Workers AI
CLOUDFLARE_API_KEY=

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID (optional, will be auto-detected via token if omitted)
CLOUDFLARE_ACCOUNT_ID=

# SMTP Email configurations for automatic reports (Laporan Otomatis)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

